# ── JarvisMax Production Environment ──────────────
# PRIVATE BETA ONLY — not a stable production deployment template.
# Fill ALL secrets with openssl rand -hex 32 or python secrets.
# NEVER commit this file with real values; it is git-ignored.

PYTHONOPTIMIZE=1
PYTHONDONTWRITEBYTECODE=1
PYTHONIOENCODING=utf-8
PYTHONUNBUFFERED=1

# API
PORT=8000
HOST=0.0.0.0

# Mémoire SQLite
SQLITE_PATH=workspace/jarvismax.db

# Mode
JARVIS_ENV=production
JARVIS_PRODUCTION=true

# Auth — REQUIRED in production
JARVIS_SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
JARVIS_ADMIN_PASSWORD=CHANGE_ME_strong_password
JARVIS_API_TOKEN=jv-CHANGE_ME

# Private-beta safety: self-improvement stays OFF by default
SELF_IMPROVE_ENABLED=false
# NEVER set BEA_SKIP_IMPROVEMENT_GATE=1

# CORS (restrict to your real frontends)
# CORS_ORIGINS=https://app.example.com

# API docs disabled by default for untrusted networks
ENABLE_API_DOCS=0
